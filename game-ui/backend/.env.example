# ─── MoveWall AI — Backend Environment Variables ──────────────────────────────
# Salin file ini menjadi .env lalu isi nilainya

# PostgreSQL Pooled Connection (untuk runtime / Vercel serverless)
# Salin dari Neon dashboard → "Pooled connection"
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.us-east-1.aws.neon.tech/movewall_db?sslmode=require"

# PostgreSQL Direct Connection (untuk prisma migrate & prisma db seed)
# Salin dari Neon dashboard → "Direct connection" (tanpa -pooler)
DIRECT_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/movewall_db?sslmode=require"

# Secret key untuk JWT (gunakan string random panjang & aman)
JWT_SECRET="ganti_dengan_random_secret_yang_panjang_dan_aman"

# Port (tidak perlu diisi di Vercel, Vercel otomatis inject PORT)
# PORT=3001

