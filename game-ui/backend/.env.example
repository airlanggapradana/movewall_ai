# ─── MoveWall AI — Backend Environment Variables ──────────────────────────────
# Salin file ini menjadi .env lalu isi nilainya

# PostgreSQL Pooled Connection (untuk runtime / Vercel serverless)
# Salin dari Neon dashboard → "Pooled connection"
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.us-east-1.aws.neon.tech/movewall_db?sslmode=require"

# PostgreSQL Direct Connection (untuk prisma migrate & prisma db seed)
# Salin dari Neon dashboard → "Direct connection" (tanpa -pooler)
DIRECT_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/movewall_db?sslmode=require"

# Secret key untuk JWT. WAJIB, minimal 32 karakter; server menolak start tanpa ini.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="ganti_dengan_random_secret_yang_panjang_dan_aman_min_32_karakter"

# Kode undangan registrasi terapis (POST /api/auth/register).
# Kosongkan untuk menutup registrasi sepenuhnya.
# REGISTRATION_INVITE_CODE=""

# Endpoint seed (POST /api/dev/seed). Hanya berfungsi di non-produksi.
# ALLOW_DEV_SEED="true"
# Kata sandi akun seed (opsional; bila kosong dibuat acak dan dicetak ke konsol)
# SEED_PASSWORD=""

# Port (tidak perlu diisi di Vercel, Vercel otomatis inject PORT)
# PORT=3001

# Midtrans Payment Gateway
MIDTRANS_SERVER_KEY="your_midtrans_server_key_here"
MIDTRANS_CLIENT_KEY="your_midtrans_client_key_here"
MIDTRANS_IS_PRODUCTION="false"
